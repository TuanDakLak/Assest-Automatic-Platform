PORT=3001
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/asset_factory?schema=public"
REDIS_HOST="localhost"
REDIS_PORT=6379
JWT_SECRET="super-secret-jwt-key-replace-in-production"

# --- GDELT DOC 2.0 API (market topic discovery) ---
# No API key needed. The API is free but rate limits hard, signalling it either
# with HTTP 429 or with HTTP 200 and an empty body. Keep the throttle generous.
GDELT_ENABLED=true
# Milliseconds between outbound requests. Below ~5000ms you will hit 429s.
GDELT_THROTTLE_MS=5000
# How long every request stands down after a 429. Honours Retry-After if sent.
GDELT_COOLDOWN_MS=60000
# Consecutive keyword failures before a discovery run gives up early. Prevents
# burning 12 minutes failing all 17 keywords while rate limited.
GDELT_MAX_CONSECUTIVE_FAILURES=3
# Hours a cached keyword snapshot stays fresh before being re-fetched.
GDELT_CACHE_TTL_HOURS=12
GDELT_TIMEOUT_MS=20000
GDELT_MAX_RETRIES=3
# Window used as the trend baseline (max 3 months — the API's coverage limit).
GDELT_BASELINE_TIMESPAN=3m
# Window used for volume, tone and competition.
GDELT_RECENT_TIMESPAN=1w
# Distinct outlets treated as a fully saturated market (competitionScore=100).
GDELT_SATURATION_CEILING=150
